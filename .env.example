VIMI_ENV=development
VIMI_DATABASE_DSN=postgresql+psycopg://vimi_app@localhost:5432/vimi
VIMI_TEMPORAL_TARGET=localhost:7233
VIMI_TEMPORAL_NAMESPACE=default
VIMI_TEMPORAL_TASK_QUEUE=vimi-social
VIMI_MEDIA_TASK_QUEUE=vimi-social-media
VIMI_DESTINATION_TASK_QUEUE=vimi-social-destination
VIMI_MEDIA_ROOT=.vimi-media
VIMI_MEDIA_MAX_BYTES=67108864
VIMI_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
VIMI_OBJECT_STORAGE_BUCKET=vimi-media
VIMI_OTEL_SERVICE_NAME=vimi-social
VIMI_TELEGRAM_BOT_TOKEN=
VIMI_TELEGRAM_WEBHOOK_SECRET=
VIMI_X_BEARER_TOKEN=
VIMI_OPENAI_API_KEY=
VIMI_VISUAL_MODERATION_MODEL=omni-moderation-latest
# Example destination credential reference target. The DB stores only
# env:VIMI_DEST_X_PRIMARY_TOKEN, never this token's plaintext value.
VIMI_DEST_X_PRIMARY_TOKEN=
