FROM python:3.12-slim AS local-ai

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIMI_LOCAL_AI_CACHE=/var/lib/vimi/ai-models

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
COPY apps ./apps

RUN python -m pip install --upgrade pip \
    && python -m pip install ".[local-ai]" \
    && groupadd --gid 10001 vimi \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin vimi \
    && mkdir -p /var/lib/vimi/ai-models \
    && chown -R 10001:10001 /var/lib/vimi

USER 10001:10001

CMD ["python", "-m", "uvicorn", "apps.local_ai.main:app", "--host", "0.0.0.0", "--port", "8090"]
