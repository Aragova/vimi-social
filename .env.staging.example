# Public hostname whose DNS A/AAAA record points at the staging VM.
VIMI_PUBLIC_HOST=staging.example.com

# PostgreSQL bootstrap/runtime credentials. Replace every CHANGE_ME value.
VIMI_POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME_bootstrap
VIMI_APP_DB_PASSWORD=CHANGE_ME_app
VIMI_MIGRATOR_DB_PASSWORD=CHANGE_ME_migrator

# Telegram bot used for staging. Keep staging separate from production.
VIMI_TELEGRAM_BOT_TOKEN=
VIMI_TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# Source connector.
VIMI_X_BEARER_TOKEN=

# Local AI Search defaults. These models run inside our own local AI containers
# and require no paid AI API or subscription.
VIMI_LOCAL_TRANSLATION_MODEL=gaudi/opus-mt-ru-en-ctranslate2
VIMI_LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
VIMI_LOCAL_AI_TIMEOUT_SECONDS=20
VIMI_SEMANTIC_RELEVANCE_MIN_SCORE=0.18

# Preview-only Visual Curator. Scout scores the official X preview image and
# never acquires the full video before the existing rights gate. Local OCR reads
# text from that same secure preview and contributes only optional rerank evidence.
VIMI_LOCAL_VISUAL_MODEL=Xenova/siglip-base-patch16-224
VIMI_VISUAL_AI_TIMEOUT_SECONDS=45
VIMI_VISUAL_RELEVANCE_WEIGHT=0.15
VIMI_PREVIEW_OCR_WEIGHT=0.10

# Paid translation is an explicit opt-in fallback only. Keeping this false means
# the key below can never be charged by Scout even if it is present.
VIMI_ALLOW_PAID_AI_FALLBACK=false
VIMI_SEARCH_TRANSLATION_API_KEY=
VIMI_SEARCH_TRANSLATION_MODEL=gpt-6-luna

# Optional AI visual moderation. This secret is scoped only to media-worker.
# Leave blank to disable sampled-frame OpenAI visual moderation.
VIMI_OPENAI_API_KEY=
VIMI_VISUAL_MODERATION_MODEL=omni-moderation-latest

# Destination credential referenced from destination_account as
# env:VIMI_DEST_X_PRIMARY_TOKEN. Never store this token in PostgreSQL.
VIMI_DEST_X_PRIMARY_TOKEN=

# Media guardrail retained from application defaults (64 MiB).
VIMI_MEDIA_MAX_BYTES=67108864
