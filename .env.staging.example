# Public hostname whose DNS A/AAAA record points at the staging VM.
VIMI_PUBLIC_HOST=staging.example.com

# PostgreSQL bootstrap/runtime credentials. Replace every CHANGE_ME value.
VIMI_POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME_bootstrap
VIMI_APP_DB_PASSWORD=CHANGE_ME_app
VIMI_MIGRATOR_DB_PASSWORD=CHANGE_ME_migrator

# Telegram bot used for staging. Keep staging separate from production.
VIMI_TELEGRAM_BOT_TOKEN=
VIMI_TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# Source connector and AI visual moderation.
VIMI_X_BEARER_TOKEN=
VIMI_OPENAI_API_KEY=
VIMI_VISUAL_MODERATION_MODEL=omni-moderation-latest

# Destination credential referenced from destination_account as
# env:VIMI_DEST_X_PRIMARY_TOKEN. Never store this token in PostgreSQL.
VIMI_DEST_X_PRIMARY_TOKEN=

# Media guardrail retained from application defaults (64 MiB).
VIMI_MEDIA_MAX_BYTES=67108864
